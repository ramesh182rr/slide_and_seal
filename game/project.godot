; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Slide & Seal"
config/description="Reconfigure reality. Control the maze. Complete the seal."
run/main_scene="res://scenes/app/app_root.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.0196, 0.0431, 0.0863, 1)
boot_splash/image="res://assets/brand/splash.png"
boot_splash/stretch_mode=1
config/icon="res://assets/brand/icon.png"
config/quit_on_go_back=false

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d.mobile=1
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
textures/vram_compression/import_etc2_astc=true
